# -----------------------------
# APPLICATION CONFIGURATION
# -----------------------------
# Options: 'local', 'staging', 'production'
NODE_ENV="local"
PORT=3000
ENABLE_REQUEST_DEBUG="true"
SHOP_UTC_OFFSET_MINUTES=420

# -----------------------------
# SECURITY CONFIGURATION
# -----------------------------
JWT_SECRET="generate_a_strong_random_string"
JWT_EXPIRES_IN="8h"

# Reverse-proxy hops in front of the app so Express resolves the real client IP.
# Staging/production (Cloudflare -> nginx -> app) = 2. Leave unset locally.
TRUST_PROXY_HOPS=2

# Global API rate limit (DoS safety net, per client IP). Defaults: 300 req / 60s.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# -----------------------------
# DATABASE CONFIGURATION
# -----------------------------
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD="root"
DB_NAME="routincafe_pos"

# -----------------------------
# SMTP CONFIGURATION (Email)
# -----------------------------
# Development: MailHog (Docker)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="RoutinCafe <no-reply@routincafe.com>"
# Production: Swap to real SMTP provider
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="email@gmail.com"
# SMTP_PASS="app-password"

# -----------------------------
# FRONTEND URL
# -----------------------------
FRONTEND_URL="http://localhost:5173"

# -----------------------------
# SEED ADMIN PASSWORD
# -----------------------------
SEED_ADMIN_PASSWORD="Password123"