# -----------------------------
# APPLICATION CONFIGURATION
# -----------------------------
# Options: 'local', 'staging', 'production'
NODE_ENV="local"
PORT=3000
ENABLE_REQUEST_DEBUG="true"

# -----------------------------
# SECURITY CONFIGURATION
# -----------------------------
JWT_SECRET="generate_a_strong_random_string"
JWT_EXPIRES_IN="8h"

# -----------------------------
# DATABASE CONFIGURATION
# -----------------------------
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD="root"
DB_NAME="routincafe_pos"