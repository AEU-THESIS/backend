// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ==========================================
// CORE: SHOP
// ==========================================
model Shop {
  id               Int      @id @default(autoincrement())
  name             String
  slug             String
  ownerName        String?  @map("owner_name")
  phone            String?
  address          String?  @db.Text
  bakongAccountId  String?  @map("bakong_account_id")
  currencySymbol   String   @default("$") @map("currency_symbol")
  exchangeRate     Decimal  @default(4100) @map("exchange_rate") @db.Decimal(10, 2)
  receiptFooter    String?  @map("receipt_footer") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  users           User[]
  roles           Role[]
  categories      Category[]
  products        Product[]
  optionSets      OptionSet[]
  promotions      Promotion[]
  ingredients     Ingredient[]
  notifications   Notification[]
  shopTables      ShopTable[]
  orders          Order[]

  @@map("shops")
}

// ==========================================
// CORE: USER (Authentication)
// ==========================================
model User {
  id           Int      @id @default(autoincrement())
  shopId       Int      @map("shop_id")
  name         String
  email        String
  password     String
  pinCode      String?  @map("pin_code")
  isPinEnabled Boolean  @default(false) @map("is_pin_enabled")
  phone        String?
  address      String?  @db.Text
  imageUrl     String?  @map("image_url") @db.LongText
  isActive     Boolean  @default(true) @map("is_active")
  employeeId   String?  @map("employee_id")
  inviteToken  String?   @map("invite_token") @db.Text
  inviteExpires DateTime? @map("invite_expires")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  isDeleted    Boolean   @default(false) @map("is_deleted")

  shop             Shop            @relation(fields: [shopId], references: [id])
  roles            RoleUser[]

  @@unique([email, isDeleted], map: "users_email_is_deleted_key")
  @@unique([employeeId, isDeleted], map: "users_employee_id_is_deleted_key")
  ingredientLogs   IngredientLog[]
  orders           Order[]
  personalTokens   PersonalAccessToken[]

  @@map("users")
}

// ==========================================
// SECURITY: ROLES & PERMISSIONS
// ==========================================
model Role {
  id     Int    @id @default(autoincrement())
  shopId Int?   @map("shop_id")
  name   String

  shop        Shop?            @relation(fields: [shopId], references: [id])
  users       RoleUser[]
  permissions PermissionRole[]

  @@map("roles")
}

model Permission {
  id   Int    @id @default(autoincrement())
  name String @unique

  roles PermissionRole[]

  @@map("permissions")
}

model RoleUser {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("role_user")
}

model PermissionRole {
  permissionId Int @map("permission_id")
  roleId       Int @map("role_id")

  permission Permission @relation(fields: [permissionId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id])

  @@id([permissionId, roleId])
  @@map("permission_role")
}

// ==========================================
// SECURITY: TOKENS
// ==========================================
model PersonalAccessToken {
  id             Int       @id @default(autoincrement())
  tokenableType  String    @map("tokenable_type")
  tokenableId    Int       @map("tokenable_id")
  name           String
  token          String    @unique
  abilities      String?   @db.Text
  lastUsedAt     DateTime? @map("last_used_at")
  expiresAt      DateTime? @map("expires_at")

  user           User      @relation(fields: [tokenableId], references: [id])

  @@map("personal_access_tokens")
}

model BlacklistedToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blacklisted_tokens")
}

// ==========================================
// REUSABLE CATALOG OPTIONS (Templates)
// ==========================================
model Category {
  id         Int      @id @default(autoincrement())
  shopId     Int      @map("shop_id")
  name       String
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  shop       Shop      @relation(fields: [shopId], references: [id])
  products   Product[]

  @@map("categories")
}

model Product {
  id          Int      @id @default(autoincrement())
  shopId      Int      @map("shop_id")
  categoryId  Int      @map("category_id")
  name        String
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?  @map("image_url") @db.LongText
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shop        Shop               @relation(fields: [shopId], references: [id])
  category    Category           @relation(fields: [categoryId], references: [id])
  optionSets  ProductOptionSet[]
  recipes     ProductRecipe[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@map("products")
}

model OptionSet {
  id        Int      @id @default(autoincrement())
  shopId    Int      @map("shop_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  shop      Shop                  @relation(fields: [shopId], references: [id])
  elements  OptionSetElement[]
  products  ProductOptionSet[]

  @@map("option_sets")
}

model OptionSetElement {
  id            Int     @id @default(autoincrement())
  optionSetId   Int     @map("option_set_id")
  label         String
  priceModifier Decimal @default(0.00) @map("price_modifier") @db.Decimal(10, 2)
  position      Int     @default(0)

  optionSet OptionSet @relation(fields: [optionSetId], references: [id])

  @@map("option_set_elements")
}

model ProductOptionSet {
  id          Int     @id @default(autoincrement())
  productId   Int     @map("product_id")
  optionSetId Int     @map("option_set_id")
  isRequired  Boolean @default(false) @map("is_required")

  product   Product   @relation(fields: [productId], references: [id])
  optionSet OptionSet @relation(fields: [optionSetId], references: [id])

  @@map("product_option_sets")
}

// ==========================================
// PROMOTIONS & DISCOUNTS
// ==========================================
model Promotion {
  id            Int       @id @default(autoincrement())
  shopId        Int       @map("shop_id")
  name          String
  discountType  String    @map("discount_type")
  discountValue Decimal   @map("discount_value") @db.Decimal(10, 2)
  isActive      Boolean   @default(false) @map("is_active")
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  createdAt     DateTime  @default(now()) @map("created_at")

  shop   Shop    @relation(fields: [shopId], references: [id])
  orders Order[]

  @@map("promotions")
}

// ==========================================
// CAFE INVENTORY (RECIPES & INGREDIENTS)
// ==========================================
model Ingredient {
  id                Int      @id @default(autoincrement())
  shopId            Int      @map("shop_id")
  name              String
  unitOfMeasure     String   @map("unit_of_measure")
  currentStock      Decimal  @default(0.00) @map("current_stock") @db.Decimal(10, 2)
  lowStockThreshold Decimal  @default(0.00) @map("low_stock_threshold") @db.Decimal(10, 2)
  updatedAt         DateTime @updatedAt @map("updated_at")

  shop    Shop            @relation(fields: [shopId], references: [id])
  recipes ProductRecipe[]
  logs    IngredientLog[]

  @@map("ingredients")
}

model ProductRecipe {
  id               Int     @id @default(autoincrement())
  productId        Int     @map("product_id")
  ingredientId     Int     @map("ingredient_id")
  quantityRequired Decimal @map("quantity_required") @db.Decimal(10, 2)

  product    Product    @relation(fields: [productId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@map("product_recipes")
}

model IngredientLog {
  id              Int      @id @default(autoincrement())
  ingredientId    Int      @map("ingredient_id")
  userId          Int      @map("user_id")
  transactionType String   @map("transaction_type")
  quantityChanged Decimal  @map("quantity_changed") @db.Decimal(10, 2)
  reason          String?
  createdAt       DateTime @default(now()) @map("created_at")

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@map("ingredient_logs")
}

// ==========================================
// REAL-TIME NOTIFICATIONS
// ==========================================
model Notification {
  id             Int       @id @default(autoincrement())
  shopId         Int       @map("shop_id")
  type           String
  notifiableType String    @map("notifiable_type")
  notifiableId   Int       @map("notifiable_id")
  data           Json
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id])

  @@map("notifications")
}

// ==========================================
// CUSTOMER SELF-SERVICE (QR & PRE-ORDER)
// ==========================================
model ShopTable {
  id          Int      @id @default(autoincrement())
  shopId      Int      @map("shop_id")
  tableNumber String   @map("table_number")
  qrToken     String   @unique @map("qr_token")
  status      String

  shop     Shop           @relation(fields: [shopId], references: [id])
  sessions TableSession[]

  @@map("shop_tables")
}

model TableSession {
  id           Int       @id @default(autoincrement())
  shopTableId  Int       @map("shop_table_id")
  sessionToken String    @unique @map("session_token")
  guestName    String?   @map("guest_name")
  expiresAt    DateTime? @map("expires_at")

  shopTable ShopTable  @relation(fields: [shopTableId], references: [id])
  cartItems CartItem[]
  orders    Order[]

  @@map("table_sessions")
}

model CartItem {
  id             Int  @id @default(autoincrement())
  tableSessionId Int  @map("table_session_id")
  productId      Int  @map("product_id")
  quantity       Int
  optionsJson    Json @map("options_json")

  tableSession TableSession @relation(fields: [tableSessionId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  @@map("cart_items")
}

// ==========================================
// ORDERS & TRANSACTIONS
// ==========================================
model Order {
  id                   Int      @id @default(autoincrement())
  shopId               Int      @map("shop_id")
  userId               Int?     @map("user_id")
  tableSessionId       Int?     @map("table_session_id")
  promotionId          Int?     @map("promotion_id")
  
  orderNumber          String   @unique @map("order_number")
  orderType            String   @map("order_type")
  
  customerName         String?  @map("customer_name")
  customerPhone        String?  @map("customer_phone")
  deliveryAddress      String?  @db.Text @map("delivery_address")

  totalAmount          Decimal  @map("total_amount") @db.Decimal(10, 2)
  discountAmount       Decimal  @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  receivedAmount       Decimal  @map("received_amount") @db.Decimal(10, 2)
  paymentCurrency      String   @map("payment_currency")
  exchangeRateSnapshot Decimal  @map("exchange_rate_snapshot") @db.Decimal(10, 2)
  
  paymentMethod        String   @map("payment_method")
  khqrString           String?  @db.Text @map("khqr_string")
  
  paymentStatus        String   @map("payment_status")
  fulfillmentStatus    String   @map("fulfillment_status")
  
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  shop         Shop          @relation(fields: [shopId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  tableSession TableSession? @relation(fields: [tableSessionId], references: [id])
  promotion    Promotion?    @relation(fields: [promotionId], references: [id])
  items        OrderItem[]
  transactions Transaction[]

  @@map("orders")
}

model OrderItem {
  id         Int     @id @default(autoincrement())
  orderId    Int     @map("order_id")
  productId  Int     @map("product_id")
  quantity   Int
  price      Decimal @db.Decimal(10, 2)
  extraPrice Decimal @default(0.00) @map("extra_price") @db.Decimal(10, 2)
  subtotal   Decimal @db.Decimal(10, 2)

  order   Order             @relation(fields: [orderId], references: [id])
  product Product           @relation(fields: [productId], references: [id])
  options OrderItemOption[]

  @@map("order_items")
}

model OrderItemOption {
  id          Int     @id @default(autoincrement())
  orderItemId Int     @map("order_item_id")
  groupName   String  @map("group_name")
  optionName  String  @map("option_name")
  extraPrice  Decimal @default(0.00) @map("extra_price") @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@map("order_item_options")
}

model Transaction {
  id            Int       @id @default(autoincrement())
  orderId       Int       @map("order_id")
  khqrString    String?   @db.Text @map("khqr_string")
  md5Hash       String?   @map("md5_hash")
  paymentMethod String    @map("payment_method")
  amount        Decimal   @db.Decimal(10, 2)
  currency      String
  payload       Json?
  status        String
  verifiedAt    DateTime? @map("verified_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("transactions")
}
