// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ==========================================
// ENUMS
// ==========================================
enum ProductType {
  drink
  food
}

enum PriceMode {
  fixed
  by_size
}

enum OptionSetType {
  size
  custom
}

// Money/fulfillment lifecycle states. Kept as DB enums so an invalid status can
// never be written (the app is the only writer, but the DB is the last guard).
enum OrderPaymentStatus {
  paid
  unpaid
  refunded
  partially_refunded
  // Fully complimentary order (total = 0 because every charged line was redeemed
  // free, e.g. a loyalty-stamp reward). Excluded from paid-only sales queries so it
  // records no phantom revenue.
  comp
}

enum OrderFulfillmentStatus {
  // A customer pre-order awaiting staff acceptance; not yet in the kitchen flow.
  pending
  preparing
  ready
  completed
  canceled
  // A customer pre-order the staff declined (distinct from a voided/canceled sale).
  rejected
}

enum TransactionStatus {
  pending
  completed
  failed
  refunded
}

// ==========================================
// CORE: SHOP
// ==========================================
model Shop {
  id                       Int      @id @default(autoincrement())
  name                     String
  slug                     String   @unique
  ownerName                String?  @map("owner_name")
  phone                    String?
  address                  String?  @db.Text
  bakongAccountId          String?  @map("bakong_account_id")
  // Admin-configurable list of banks a customer may pay via manual KHQR (e.g.
  // ["ABA","ACLEDA","Wing"]). Served to the POS bank selector. Null/empty is
  // coalesced to a default of ["ABA"] in the service layer.
  paymentBanks             Json?    @map("payment_banks")
  currencySymbol           String   @default("$") @map("currency_symbol")
  exchangeRate             Decimal  @default(4100) @map("exchange_rate") @db.Decimal(10, 2)
  receiptFooter            String?  @map("receipt_footer") @db.Text
  isOrderManagementEnabled Boolean  @default(true) @map("is_order_management_enabled")
  isShopClosed             Boolean  @default(false) @map("is_shop_closed")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  users                    User[]
  roles                    Role[]
  categories               Category[]
  products                 Product[]
  optionSets               OptionSet[]
  variationGroupTemplates  VariationGroupTemplate[]
  promotions               Promotion[]
  ingredients              Ingredient[]
  notifications            Notification[]
  shopTables               ShopTable[]
  orders                   Order[]
  blockedTelegramCustomers BlockedTelegramCustomer[]

  @@map("shops")
}

// ==========================================
// CORE: USER (Authentication)
// ==========================================
model User {
  id            Int       @id @default(autoincrement())
  shopId        Int       @map("shop_id")
  name          String
  email         String
  password      String
  pinCode       String?   @map("pin_code")
  isPinEnabled  Boolean   @default(false) @map("is_pin_enabled")
  phone         String?
  address       String?   @db.Text
  imageUrl      String?   @map("image_url") @db.LongText
  isActive      Boolean   @default(true) @map("is_active")
  employeeId    String?   @map("employee_id")
  inviteToken   String?   @map("invite_token") @db.Text
  inviteExpires DateTime? @map("invite_expires")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  isDeleted     Boolean   @default(false) @map("is_deleted")

  shop                    Shop                     @relation(fields: [shopId], references: [id])
  roles                   RoleUser[]
  ingredientLogs          IngredientLog[]
  variationGroupTemplates VariationGroupTemplate[]
  orders                  Order[]                  @relation("OrderCreatedBy")
  voidedOrders            Order[]                  @relation("OrderVoidedBy")
  transactions            Transaction[]
  personalTokens          PersonalAccessToken[]

  @@unique([email, isDeleted], map: "users_email_is_deleted_key")
  @@unique([employeeId, isDeleted], map: "users_employee_id_is_deleted_key")
  @@map("users")
}

// ==========================================
// SECURITY: ROLES & PERMISSIONS
// ==========================================
model Role {
  id     Int    @id @default(autoincrement())
  shopId Int?   @map("shop_id")
  name   String

  shop        Shop?            @relation(fields: [shopId], references: [id])
  users       RoleUser[]
  permissions PermissionRole[]

  @@map("roles")
}

model Permission {
  id   Int    @id @default(autoincrement())
  name String @unique

  roles PermissionRole[]

  @@map("permissions")
}

model RoleUser {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("role_user")
}

model PermissionRole {
  permissionId Int @map("permission_id")
  roleId       Int @map("role_id")

  permission Permission @relation(fields: [permissionId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id])

  @@id([permissionId, roleId])
  @@map("permission_role")
}

// ==========================================
// SECURITY: TOKENS
// ==========================================
model PersonalAccessToken {
  id            Int       @id @default(autoincrement())
  tokenableType String    @map("tokenable_type")
  tokenableId   Int       @map("tokenable_id")
  name          String
  token         String    @unique
  abilities     String?   @db.Text
  lastUsedAt    DateTime? @map("last_used_at")
  expiresAt     DateTime? @map("expires_at")

  user User @relation(fields: [tokenableId], references: [id])

  @@map("personal_access_tokens")
}

model BlacklistedToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blacklisted_tokens")
}

// ==========================================
// REUSABLE CATALOG OPTIONS (Templates)
// ==========================================
model Category {
  id        Int      @id @default(autoincrement())
  shopId    Int      @map("shop_id")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  shop        Shop                @relation(fields: [shopId], references: [id])
  products    Product[]
  promotions  PromotionCategory[]
  ingredients Ingredient[]

  @@map("categories")
}

model Product {
  id          Int         @id @default(autoincrement())
  shopId      Int         @map("shop_id")
  categoryId  Int         @map("category_id")
  name        String
  price       Decimal?    @db.Decimal(10, 2)
  imageUrl    String?     @map("image_url") @db.LongText
  isAvailable Boolean     @default(true) @map("is_available")
  type        ProductType @default(drink) @map("type")
  priceMode   PriceMode   @default(fixed) @map("price_mode")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  shop       Shop               @relation(fields: [shopId], references: [id])
  category   Category           @relation(fields: [categoryId], references: [id])
  optionSets ProductOptionSet[]
  recipes    ProductRecipe[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  promotions PromotionProduct[]

  @@map("products")
}

model OptionSet {
  id        Int           @id @default(autoincrement())
  shopId    Int           @map("shop_id")
  name      String
  type      OptionSetType @map("type")
  createdAt DateTime      @default(now()) @map("created_at")

  shop     Shop               @relation(fields: [shopId], references: [id])
  elements OptionSetElement[]
  products ProductOptionSet[]

  @@map("option_sets")
}

model OptionSetElement {
  id            Int     @id @default(autoincrement())
  optionSetId   Int     @map("option_set_id")
  label         String
  priceModifier Decimal @default(0.00) @map("price_modifier") @db.Decimal(10, 2)
  position      Int     @default(0)

  optionSet OptionSet @relation(fields: [optionSetId], references: [id], onDelete: Cascade)

  @@map("option_set_elements")
}

model ProductOptionSet {
  id          Int     @id @default(autoincrement())
  productId   Int     @map("product_id")
  optionSetId Int     @map("option_set_id")
  isRequired  Boolean @default(false) @map("is_required")

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionSet OptionSet @relation(fields: [optionSetId], references: [id], onDelete: Cascade)

  @@map("product_option_sets")
}

model VariationGroupTemplate {
  id          Int      @id @default(autoincrement())
  shopId      Int      @map("shop_id")
  name        String
  description String?  @db.Text
  category    String
  createdBy   Int      @map("created_by")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shop    Shop                           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  creator User                           @relation(fields: [createdBy], references: [id])
  options VariationGroupTemplateOption[]

  @@index([shopId, isActive])
  @@map("variation_group_templates")
}

model VariationGroupTemplateOption {
  id            Int      @id @default(autoincrement())
  templateId    Int      @map("template_id")
  optionLabel   String   @map("option_label")
  priceModifier Decimal  @default(0.00) @map("price_modifier") @db.Decimal(10, 2)
  displayOrder  Int      @default(0) @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  template VariationGroupTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, displayOrder])
  @@map("variation_group_template_options")
}

// ==========================================
// PROMOTIONS & DISCOUNTS
// ==========================================
model Promotion {
  id            Int       @id @default(autoincrement())
  shopId        Int       @map("shop_id")
  name          String
  code          String?
  discountType  String    @map("discount_type") // PERCENTAGE | FIXED_AMOUNT | BOGO
  discountValue Decimal   @default(0.00) @map("discount_value") @db.Decimal(10, 2)
  scope         String    @default("ALL") // ALL | SPECIFIC
  timesRedeemed Int       @default(0) @map("times_redeemed")
  isActive      Boolean   @default(false) @map("is_active")
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  createdAt     DateTime  @default(now()) @map("created_at")

  shop            Shop                @relation(fields: [shopId], references: [id])
  orders          Order[]
  orderPromotions OrderPromotion[]
  categories      PromotionCategory[]
  products        PromotionProduct[]

  @@index([shopId])
  @@map("promotions")
}

// Pivot: promotions scoped to specific categories
model PromotionCategory {
  promotionId Int @map("promotion_id")
  categoryId  Int @map("category_id")

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@index([categoryId])
  @@map("promotion_category")
}

// Pivot: promotions scoped to specific products
model PromotionProduct {
  promotionId Int @map("promotion_id")
  productId   Int @map("product_id")

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
  @@map("promotion_product")
}

// ==========================================
// CAFE INVENTORY (RECIPES & INGREDIENTS)
// ==========================================
model Ingredient {
  id                Int       @id @default(autoincrement())
  shopId            Int       @map("shop_id")
  categoryId        Int?      @map("category_id")
  name              String
  unitOfMeasure     String    @map("unit_of_measure")
  currentStock      Decimal   @default(0.00) @map("current_stock") @db.Decimal(10, 2)
  lowStockThreshold Decimal   @default(0.00) @map("low_stock_threshold") @db.Decimal(10, 2)
  // Weighted-average cost per unit. 4 dp (not 2) so small per-unit costs — e.g.
  // coffee at $18/kg = $0.018/g — aren't rounded to zero.
  unitCost          Decimal   @default(0.0000) @map("unit_cost") @db.Decimal(12, 4)
  // Most recent purchase price per unit (the price from the last stock-in).
  lastUnitCost      Decimal   @default(0.0000) @map("last_unit_cost") @db.Decimal(12, 4)
  // Currency the cost figures are recorded in (the shop's configured currency).
  // Currency the cost figures are recorded in. No default: it is always derived
  // from the owning Shop's currencySymbol, so a blanket '$' here would silently
  // mislabel local-currency costs.
  costCurrency      String    @map("cost_currency")
  imageUrl          String?   @map("image_url") @db.LongText
  // Soft delete. IngredientLog rows are an immutable audit trail, so removing an
  // item hides it from the catalogue rather than destroying its stock history.
  deletedAt         DateTime? @map("deleted_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  shop     Shop            @relation(fields: [shopId], references: [id])
  category Category?       @relation(fields: [categoryId], references: [id])
  recipes  ProductRecipe[]
  logs     IngredientLog[]

  @@index([shopId, deletedAt])
  @@index([categoryId])
  @@map("ingredients")
}

model ProductRecipe {
  id               Int     @id @default(autoincrement())
  productId        Int     @map("product_id")
  ingredientId     Int     @map("ingredient_id")
  quantityRequired Decimal @map("quantity_required") @db.Decimal(10, 2)

  product    Product    @relation(fields: [productId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@map("product_recipes")
}

model IngredientLog {
  id              Int      @id @default(autoincrement())
  ingredientId    Int      @map("ingredient_id")
  userId          Int      @map("user_id")
  transactionType String   @map("transaction_type")
  quantityChanged Decimal  @map("quantity_changed") @db.Decimal(10, 2)
  // Purchase price per unit at the moment of a stock-in (USD base). Null for
  // removals. Captures cost history so past spend can be reconstructed later.
  unitCost        Decimal? @map("unit_cost") @db.Decimal(12, 4)
  reason          String?
  createdAt       DateTime @default(now()) @map("created_at")

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@map("ingredient_logs")
}

// ==========================================
// REAL-TIME NOTIFICATIONS
// ==========================================
model Notification {
  id             Int       @id @default(autoincrement())
  shopId         Int       @map("shop_id")
  type           String
  notifiableType String    @map("notifiable_type")
  notifiableId   Int       @map("notifiable_id")
  data           Json
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id])

  @@map("notifications")
}

// ==========================================
// CUSTOMER SELF-SERVICE (QR & PRE-ORDER)
// ==========================================
model ShopTable {
  id          Int    @id @default(autoincrement())
  shopId      Int    @map("shop_id")
  tableNumber String @map("table_number")
  qrToken     String @unique @map("qr_token")
  status      String

  shop     Shop           @relation(fields: [shopId], references: [id])
  sessions TableSession[]

  @@map("shop_tables")
}

model TableSession {
  id           Int       @id @default(autoincrement())
  shopTableId  Int       @map("shop_table_id")
  sessionToken String    @unique @map("session_token")
  guestName    String?   @map("guest_name")
  expiresAt    DateTime? @map("expires_at")

  shopTable ShopTable  @relation(fields: [shopTableId], references: [id])
  cartItems CartItem[]
  orders    Order[]

  @@map("table_sessions")
}

model CartItem {
  id             Int  @id @default(autoincrement())
  tableSessionId Int  @map("table_session_id")
  productId      Int  @map("product_id")
  quantity       Int
  optionsJson    Json @map("options_json")

  tableSession TableSession @relation(fields: [tableSessionId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  @@map("cart_items")
}

// ==========================================
// ORDERS & TRANSACTIONS
// ==========================================
model Order {
  id             Int  @id @default(autoincrement())
  shopId         Int  @map("shop_id")
  userId         Int? @map("user_id")
  tableSessionId Int? @map("table_session_id")
  promotionId    Int? @map("promotion_id")

  orderNumber String @unique @map("order_number")
  orderType   String @map("order_type")

  customerName     String?  @map("customer_name")
  customerPhone    String?  @map("customer_phone")
  deliveryAddress  String?  @map("delivery_address") @db.Text
  // Customer-shared GPS coordinates for a delivery pre-order. Stored as-is (no
  // reverse-geocoding); staff open a Google Maps link built from these.
  deliveryLat      Decimal? @map("delivery_lat") @db.Decimal(10, 7)
  deliveryLng      Decimal? @map("delivery_lng") @db.Decimal(10, 7)
  // Telegram identity of the guest who placed a Mini App pre-order (verified via
  // initData). Null for staff-created POS orders.
  telegramUserId   String?  @map("telegram_user_id")
  telegramUsername String?  @map("telegram_username")
  telegramChatId   String?  @map("telegram_chat_id")
  telegramMessageId Int?    @map("telegram_message_id")

  totalAmount          Decimal @map("total_amount") @db.Decimal(10, 2)
  discountAmount       Decimal @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  receivedAmount       Decimal @map("received_amount") @db.Decimal(10, 2)
  // Received amount normalised to USD (receivedAmount holds the native payment
  // currency — riel for KHR payments, dollars for USD). Powers currency-agnostic
  // reporting so a mixed-currency day can be summed in a single column.
  receivedAmountUsd    Decimal @default(0.00) @map("received_amount_usd") @db.Decimal(10, 2)
  // Change returned to the customer, in the payment currency (note-rounded for KHR).
  changeAmount         Decimal @default(0.00) @map("change_amount") @db.Decimal(10, 2)
  paymentCurrency      String  @map("payment_currency")
  // Snapshot of the shop's exchange rate at checkout (server-authoritative).
  exchangeRateSnapshot Decimal @map("exchange_rate_snapshot") @db.Decimal(10, 2)

  paymentMethod String  @map("payment_method")
  khqrString    String? @map("khqr_string") @db.Text
  // Bank the customer used for a manual KHQR (bank transfer) payment — recorded by
  // staff at checkout for reporting. Null for cash orders. Chosen from the shop's
  // configurable `paymentBanks` list (see Shop.paymentBanks).
  bankName      String? @map("bank_name")

  paymentStatus     OrderPaymentStatus     @map("payment_status")
  fulfillmentStatus OrderFulfillmentStatus @map("fulfillment_status")

  // Void audit: who reversed the whole order, when, and why. Set only when an
  // order is voided (paymentStatus -> refunded, fulfillmentStatus -> canceled).
  voidedAt       DateTime? @map("voided_at")
  voidedByUserId Int?      @map("voided_by_user_id")
  voidReason     String?   @map("void_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop              Shop             @relation(fields: [shopId], references: [id])
  user              User?            @relation("OrderCreatedBy", fields: [userId], references: [id])
  voidedBy          User?            @relation("OrderVoidedBy", fields: [voidedByUserId], references: [id])
  tableSession      TableSession?    @relation(fields: [tableSessionId], references: [id])
  promotion         Promotion?       @relation(fields: [promotionId], references: [id])
  items             OrderItem[]
  transactions      Transaction[]
  appliedPromotions OrderPromotion[]

  @@index([shopId, createdAt])
  @@index([shopId, paymentStatus, createdAt])
  @@index([shopId, fulfillmentStatus])
  @@map("orders")
}

// Pivot: every promotion applied to an order and how much it discounted. Promotions
// stack (one per item), so an order can carry several; `discountAmount` on the order
// is the sum, and `promotionId` records the single largest for quick reference.
model OrderPromotion {
  orderId        Int     @map("order_id")
  promotionId    Int     @map("promotion_id")
  discountAmount Decimal @default(0.00) @map("discount_amount") @db.Decimal(10, 2)

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id])

  @@id([orderId, promotionId])
  @@index([promotionId])
  @@map("order_promotion")
}

model OrderItem {
  id         Int     @id @default(autoincrement())
  orderId    Int     @map("order_id")
  productId  Int     @map("product_id")
  quantity   Int
  price      Decimal @db.Decimal(10, 2)
  extraPrice Decimal @default(0.00) @map("extra_price") @db.Decimal(10, 2)
  subtotal   Decimal @db.Decimal(10, 2)

  // Complimentary line (e.g. a loyalty-stamp "buy 10 get 1 free" redemption). A comp
  // line is persisted with subtotal = 0 so it adds no revenue to any report, while
  // price/extraPrice are kept so the receipt can still show its normal (struck) price.
  // compReason records why it was given free — a permanent audit trail on the order.
  isComplimentary Boolean @default(false) @map("is_complimentary")
  compReason      String? @map("comp_reason")

  // Item cancellation (whole-line). canceledQuantity mirrors quantity when
  // cancelled; the row is kept (struck through in the UI), never deleted, so the
  // order still shows what was originally ordered.
  canceledAt       DateTime? @map("canceled_at")
  canceledQuantity Int       @default(0) @map("canceled_quantity")

  order   Order             @relation(fields: [orderId], references: [id])
  product Product           @relation(fields: [productId], references: [id])
  options OrderItemOption[]

  @@map("order_items")
}

model OrderItemOption {
  id          Int     @id @default(autoincrement())
  orderItemId Int     @map("order_item_id")
  groupName   String  @map("group_name")
  optionName  String  @map("option_name")
  extraPrice  Decimal @default(0.00) @map("extra_price") @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@map("order_item_options")
}

model Transaction {
  id            Int               @id @default(autoincrement())
  orderId       Int               @map("order_id")
  userId        Int?              @map("user_id")
  khqrString    String?           @map("khqr_string") @db.Text
  md5Hash       String?           @map("md5_hash")
  paymentMethod String            @map("payment_method")
  // Signed amount in `currency`: positive for a payment, negative for a refund.
  amount        Decimal           @db.Decimal(10, 2)
  currency      String
  payload       Json?
  status        TransactionStatus
  verifiedAt    DateTime?         @map("verified_at")

  order Order @relation(fields: [orderId], references: [id])
  user  User? @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@map("transactions")
}

// Temporary block-list for abusive Telegram guests. A staff member taps "Block"
// on the group notification; further Mini App pre-orders from this telegramUserId
// are rejected until `blockedUntil`. Temporary by design so a mistaken block
// self-resolves — there is no permanent ban.
model BlockedTelegramCustomer {
  id               Int       @id @default(autoincrement())
  shopId           Int       @map("shop_id")
  telegramUserId   String    @map("telegram_user_id")
  telegramUsername String?   @map("telegram_username")
  // Null = blocked forever; a date = blocked until then. isBlocked treats a past
  // date as expired (the block self-lifts).
  blockedUntil     DateTime? @map("blocked_until")
  reason           String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id])

  @@unique([shopId, telegramUserId])
  @@index([shopId, telegramUserId])
  @@map("blocked_telegram_customers")
}
